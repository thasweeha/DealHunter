# Copy to .env and fill in
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_PATH=data/dealhunter.db
ZIP_CODE=63005
SCRAPE_INTERVAL_MINUTES=30
ALERT_MIN_DISCOUNT_PCT=20.0

# --- Optional provider keys (all key-gated providers skip cleanly if empty) ---
# SerpApi Google Shopping, zip-localized prices. Free ~100 searches/mo;
# the app self-throttles to 1 run/day. Get a key at serpapi.com.
SERPAPI_KEY=
# Takeads (Mitgo) coupon feed + per-deal code matching. Free publisher
# account at takeads.com -> platform Public key.
TAKEADS_KEY=
# Strackr affiliate hub: key + your account's deals-export URL from the
# Strackr dashboard (they issue account-specific REST/CSV endpoints).
STRACKR_KEY=
STRACKR_API_BASE=
